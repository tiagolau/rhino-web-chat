# Rhino Webchat — variáveis de ambiente
# Gere segredos com: openssl rand -hex 32   (CPF_ENC_KEY precisa ser exatamente 32 bytes = 64 hex)

PUBLIC_URL=https://webchat.engrenatec.com.br
PORT=3000
DATABASE_URL=postgres://webchat:SENHA@postgres:5432/webchat

# Token do navegador
SESSION_SECRET=
SESSION_DAYS=90

# CPF: NÃO trocar depois de em produção (invalida hashes e cópias cifradas)
CPF_PEPPER=
CPF_ENC_KEY=

# DataCrazy (tenant RJ Global)
DATACRAZY_API_BASE=https://api.g1.datacrazy.io
DATACRAZY_API_TOKEN=
DC_REST_PER_MINUTE=10

# Portais que carregam o widget (separados por vírgula)
ALLOWED_ORIGINS=https://ava07.eduno.com.br

# Anexos
FILES_DIR=/data/files
MAX_UPLOAD_MB=15

# Anti-abuso
DEVICE_CPF_LIMIT=3
IP_CPF_LIMIT_PER_HOUR=30

# Rotas /admin/* (header X-Admin-Key)
ADMIN_API_KEY=

LOG_LEVEL=info

# Só para a stack (docker stack deploy)
POSTGRES_PASSWORD=
