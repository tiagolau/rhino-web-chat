# Rhino Webchat — variáveis de ambiente
#
# Desenvolvimento: copie para app/.env.
# Produção:        copie para app/deploy/.env.production (lido por deploy.sh e stack.yml).
#
# Gere segredos com: openssl rand -hex 32   (CPF_ENC_KEY precisa ser exatamente 32 bytes = 64 hex)

PUBLIC_URL=http://localhost:3000
PORT=3000
# Local: postgres://localhost/rhino_webchat. Na stack, o DATABASE_URL é montado
# a partir de POSTGRES_PASSWORD e esta linha é ignorada.
DATABASE_URL=postgres://localhost/rhino_webchat

# Token do navegador
SESSION_SECRET=
SESSION_DAYS=90

# CPF: NÃO trocar depois de em produção (invalida hashes, cópias cifradas e o
# contactId dos alunos no DataCrazy). Ver docs/passagem-rj-global.md.
CPF_PEPPER=
CPF_ENC_KEY=

# DataCrazy (tenant RJ Global): chave da REST, com o prefixo dc_ se houver
DATACRAZY_API_BASE=https://api.g1.datacrazy.io
DATACRAZY_API_TOKEN=
DATACRAZY_UPLOAD_BASE=https://crm.g1.datacrazy.io
DATACRAZY_CDN_BASE=https://g1cdn1.datacrazy.io
DC_REST_PER_MINUTE=10

# Portais que carregam o widget (separados por vírgula)
ALLOWED_ORIGINS=https://ava07.eduno.com.br

# Anexos
FILES_DIR=./data/files
MAX_UPLOAD_MB=15
# Transferir anexos para o CDN do CRM e remover cópias locais verificadas.
ANEXOS_NO_CRM=false

# Anti-abuso
DEVICE_CPF_LIMIT=3
IP_CPF_LIMIT_PER_HOUR=30

# Rotas /admin/* (header X-Admin-Key)
ADMIN_API_KEY=

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Só para produção (docker stack deploy e app/deploy/deploy.sh)

POSTGRES_PASSWORD=

# Domínio público e Traefik do servidor
WEBCHAT_DOMAIN=webchat.exemplo.com.br
TRAEFIK_NETWORK=
TRAEFIK_CERTRESOLVER=letsencryptresolver
TRAEFIK_ENTRYPOINT=websecure

# Acesso SSH do deploy.sh (a chave é opcional se o ssh-agent já tiver acesso)
WEBCHAT_SSH_HOST=root@203.0.113.10
WEBCHAT_SSH_KEY=
